{
  "name": "tri_platform_enterprise_migration_orchestrator",
  "email_notifications": {
    "on_failure": ["data-modernization-oncall@company.com"]
  },
  "timeout_seconds": 10800,
  "max_concurrent_runs": 1,
  "tasks": [
    {
      "task_key": "step1_sync_palantir_foundry_delta",
      "pipeline_task": {
        "pipeline_id": "dlt-pipeline-supply-chain-gold-uuid"
      },
      "timeout_seconds": 3600
    },
    {
      "task_key": "step2_ingest_oracle_cdc_stream",
      "pipeline_task": {
        "pipeline_id": "dlt-pipeline-oracle-cdc-uuid"
      },
      "timeout_seconds": 3600
    },
    {
      "task_key": "step3_transpile_and_run_oracle_plsql",
      "depends_on": [{ "task_key": "step2_ingest_oracle_cdc_stream" }],
      "spark_python_task": {
        "python_file": "dbfs:/pipelines/oracle/oracle_plsql_to_pyspark_engine.py"
      }
    },
    {
      "task_key": "step4_transpile_and_run_snowflake_analytics",
      "depends_on": [{ "task_key": "step1_sync_palantir_foundry_delta" }],
      "spark_python_task": {
        "python_file": "dbfs:/pipelines/snowflake/snowpark_to_pyspark_converter.py"
      }
    },
    {
      "task_key": "step5_run_tri_platform_ai_reconciliation",
      "depends_on": [
        { "task_key": "step3_transpile_and_run_oracle_plsql" },
        { "task_key": "step4_transpile_and_run_snowflake_analytics" }
      ],
      "spark_python_task": {
        "python_file": "dbfs:/pipelines/reconciliation/ai_multi_source_reconciliation.py"
      }
    }
  ],
  "format": "MULTI_TASK"
}
