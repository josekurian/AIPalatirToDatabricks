{
  "name": "enterprise_supply_chain_orchestration_job",
  "email_notifications": {
    "on_failure": ["data-ops-oncall@company.com"],
    "no_alert_for_skipped_runs": false
  },
  "timeout_seconds": 7200,
  "max_concurrent_runs": 1,
  "tasks": [
    {
      "task_key": "run_dlt_supply_chain_pipeline",
      "pipeline_task": {
        "pipeline_id": "dlt-pipeline-supply-chain-gold-uuid",
        "full_refresh": false
      },
      "timeout_seconds": 3600
    },
    {
      "task_key": "optimize_and_vacuum_gold_tables",
      "depends_on": [{ "task_key": "run_dlt_supply_chain_pipeline" }],
      "sql_task": {
        "query": {
          "query_id": "query-optimize-gold-tables"
        },
        "warehouse_id": "serverless-sql-prod-wh"
      }
    },
    {
      "task_key": "sync_mosaic_vector_search_indexes",
      "depends_on": [{ "task_key": "optimize_and_vacuum_gold_tables" }],
      "notebook_task": {
        "notebook_path": "/Workspace/EnterpriseOperations/MosaicAI/sync_inventory_vector_index",
        "source": "WORKSPACE"
      }
    },
    {
      "task_key": "run_automated_data_reconciliation",
      "depends_on": [{ "task_key": "optimize_and_vacuum_gold_tables" }],
      "spark_python_task": {
        "python_file": "dbfs:/pipelines/reconciliation/run_checksum_verification.py",
        "parameters": [
          "--source-system", "palantir_foundry",
          "--target-catalog", "enterprise_operations"
        ]
      }
    }
  ],
  "format": "MULTI_TASK"
}
